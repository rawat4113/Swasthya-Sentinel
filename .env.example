APP_NAME=Swasthya Sentinel
APP_ENV=development
DATABASE_FILE=swasthya_sentinel.json
OPENAQ_API_KEY=
DATA_MODE=demo
AUTO_REFRESH_ENABLED=false
REFRESH_INTERVAL_MINUTES=30
MIN_GROUP_SIZE=10
DISTRICT_CONFIG=config/district.yaml
API_BASE_URL=http://127.0.0.1:8001

# Change AUTH_SECRET_KEY before exposing the app beyond a local demo.
AUTH_SECRET_KEY=CHANGE-ME-use-a-long-random-secret-before-deployment
DEMO_USERS_ENABLED=true
ACCESS_TOKEN_HOURS=8
